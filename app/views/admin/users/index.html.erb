<% content_for :title, "Users" %>

<h1 class="text-2xl font-bold text-slate-900">Users</h1>

<div class="mt-6 overflow-x-auto rounded border border-slate-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-slate-200 text-slate-600">
      <tr>
        <th class="px-4 py-2 font-medium">Email</th>
        <th class="px-4 py-2 font-medium">Sign-in</th>
        <th class="px-4 py-2 font-medium">Confirmed</th>
        <th class="px-4 py-2 font-medium">Admin</th>
      </tr>
    </thead>

    <tbody data-testid="user-rows">
      <% @users.each do |user| %>
        <tr class="border-b border-slate-100 last:border-0">
          <td class="px-4 py-2">
            <%= link_to user.email, admin_user_path(user), class: "text-indigo-600 underline" %>
          </td>
          <td class="px-4 py-2 text-slate-600"><%= user.provider.presence || "password" %></td>
          <td class="px-4 py-2 text-slate-600"><%= user.confirmed? ? "yes" : "no" %></td>
          <td class="px-4 py-2 text-slate-600"><%= user.admin? ? "yes" : "no" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>