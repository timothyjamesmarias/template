<nav class="border-b border-slate-200">
  <div class="container mx-auto flex items-center justify-between px-5 py-3 text-sm">
    <%= link_to "Template", root_path, class: "font-semibold text-slate-900" %>

    <div class="flex items-center gap-4">
      <% if user_signed_in? %>
        <% if current_user.can_administer? %>
          <%= link_to "Admin", admin_root_path, data: { testid: "admin-link" }, class: "text-slate-600 underline" %>
        <% end %>
        <span data-testid="current-user" class="text-slate-600"><%= current_user.email %></span>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              data: { testid: "sign-out" }, class: "text-slate-600 underline" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, data: { testid: "sign-in" }, class: "text-slate-600 underline" %>
        <%= link_to "Sign up", new_user_registration_path, data: { testid: "sign-up" }, class: "text-slate-600 underline" %>
      <% end %>
    </div>
  </div>
</nav>