<%= render layout: "devise/shared/auth_page", locals: { title: "Sign in" } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
        html: { class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/field", form: f, attribute: :email, as: :email_field,
          options: { autofocus: true, autocomplete: "email" } %>

    <%= render "devise/shared/field", form: f, attribute: :password, as: :password_field,
          options: { autocomplete: "current-password" } %>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-slate-700">
        <%= f.check_box :remember_me %>
        Remember me
      </label>
    <% end %>

    <%= f.submit "Sign in",
          class: "w-full rounded bg-indigo-600 px-3 py-2 text-sm text-white" %>
  <% end %>

  <%= render "devise/shared/google_button" %>
<% end %>
