<div class="mx-auto w-full max-w-sm">
  <h1 class="text-2xl font-bold text-slate-900">Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            data: { testid: "email" },
            class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm text-slate-700" %>
      <%= f.password_field :password, autocomplete: "current-password",
            data: { testid: "password" },
            class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-slate-700">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, class: "font-normal" %>
      </label>
    <% end %>

    <%= f.submit "Sign in", data: { testid: "submit" },
          class: "w-full rounded bg-indigo-600 px-3 py-2 text-sm text-white" %>
  <% end %>

  <%= render "devise/shared/google_button" %>

  <div class="mt-6 text-sm text-slate-600">
    <%= render "devise/shared/links" %>
  </div>
</div>