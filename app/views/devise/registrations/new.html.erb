<%= render layout: "devise/shared/auth_page", locals: { title: "Sign up" } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
        html: { class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/field", form: f, attribute: :email, as: :email_field,
          options: { autofocus: true, autocomplete: "email" } %>

    <%= render "devise/shared/field", form: f, attribute: :password, as: :password_field,
          hint: (@minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil),
          options: { autocomplete: "new-password" } %>

    <%= render "devise/shared/field", form: f, attribute: :password_confirmation, as: :password_field,
          options: { autocomplete: "new-password" } %>

    <%= f.submit "Sign up",
          class: "w-full rounded bg-indigo-600 px-3 py-2 text-sm text-white" %>
  <% end %>

  <%= render "devise/shared/google_button" %>
<% end %>
