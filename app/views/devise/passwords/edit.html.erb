<%= render layout: "devise/shared/auth_page",
           locals: { title: "Choose a new password" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
        html: { method: :put, class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <%= render "devise/shared/field", form: f, attribute: :password, as: :password_field,
          hint: (@minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil),
          options: { autofocus: true, autocomplete: "new-password" } %>

    <%= render "devise/shared/field", form: f, attribute: :password_confirmation, as: :password_field,
          options: { autocomplete: "new-password" } %>

    <%= f.submit "Change my password",
          class: "w-full rounded bg-indigo-600 px-3 py-2 text-sm text-white" %>
  <% end %>
<% end %>
