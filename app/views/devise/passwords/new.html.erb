<%= render layout: "devise/shared/auth_page",
           locals: { title: "Forgot your password?",
                     subtitle: "We'll email you a link to set a new one." } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
        html: { method: :post, class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/field", form: f, attribute: :email, as: :email_field,
          options: { autofocus: true, autocomplete: "email" } %>

    <%= f.submit "Send reset instructions",
          class: "w-full rounded bg-indigo-600 px-3 py-2 text-sm text-white" %>
  <% end %>
<% end %>
