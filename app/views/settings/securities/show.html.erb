<% content_for :title, "Security" %>

<h2 class="text-lg font-medium text-slate-900">Security</h2>

<dl class="mt-4 max-w-sm divide-y divide-slate-100 rounded border border-slate-200 text-sm">
  <div class="flex justify-between px-4 py-3">
    <dt class="text-slate-600">Sign-in</dt>
    <dd class="text-slate-900"><%= @user.provider.presence || "Email and password" %></dd>
  </div>

  <div class="flex justify-between px-4 py-3">
    <dt class="text-slate-600">Email confirmed</dt>
    <dd class="text-slate-900"><%= @user.confirmed_at&.to_fs(:short) || "Not confirmed" %></dd>
  </div>
</dl>

<div class="mt-10 max-w-sm border-t border-slate-200 pt-6">
  <h3 class="text-sm font-medium text-slate-900">Delete account</h3>
  <p class="mt-1 text-sm text-slate-600">This cannot be undone.</p>

  <%= button_to "Delete my account", user_registration_path, method: :delete,
        data: { turbo_confirm: "Delete your account? This cannot be undone." },
        class: "mt-3 rounded border border-red-300 px-3 py-1.5 text-sm text-red-700" %>
</div>
