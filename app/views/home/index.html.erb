<div class="w-full">
  <h1 id="greeting" class="text-3xl font-bold text-indigo-600">Hello from Vite</h1>

  <p class="mt-2 text-slate-600">
    This is a Turbo page. Small interactions use Stimulus.
  </p>

  <div data-controller="copy-button"
       data-copy-button-text-value="copied-from-stimulus"
       data-copy-button-confirm-duration-value="10000"
       class="mt-4">
    <button data-action="click->copy-button#copy"
            class="rounded bg-slate-900 px-3 py-1.5 text-sm text-white">
      <span data-copy-button-target="label">Copy</span>
    </button>
  </div>

  <p class="mt-6">
    <%= link_to "Dashboard (React page-app)", dashboard_path, class: "text-indigo-600 underline" %>
  </p>
</div>